---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";
import { AUTHOR_INITIAL, url as baseUrl } from "../../config";

export async function getStaticPaths({ paginate }) {
    const notes = await getCollection("notes");
    notes.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return paginate(notes, { pageSize: 100 });
}

const { page } = Astro.props;

// 按「学习项目」分组展示
const CATEGORY_ORDER = [
    "多智能体编排",
    "AI 开发方法论",
    "OMX / Codex 工作流",
    "代码审查",
    "技能库 / 框架",
    "专项工具 / 科研",
];
const groups = CATEGORY_ORDER.map((cat) => ({
    name: cat,
    items: page.data.filter((n) => n.data.category === cat),
}));
const hasAny = groups.some((g) => g.items.length > 0);
---

<BaseLayout title={AUTHOR_INITIAL + " | Notes"} sideBarActiveItemID="notes">
    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Notes</div>
    </div>

    {
        !hasAny ? (
            <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
                <p class="font-bold">Sorry!</p>
                <p>
                    There are no notes to show at the moment. Check back later!
                </p>
            </div>
        ) : (
            groups.map((group) =>
                group.items.length > 0 ? (
                    <section class="mb-8">
                        <h2 class="text-xl font-bold mb-3 text-primary">
                            {group.name}
                        </h2>
                        <ul>
                            {group.items.map((note) => (
                                <>
                                    <HorizontalCard
                                        title={note.data.title}
                                        img={note.data.heroImage}
                                        desc={note.data.description}
                                        url={
                                            baseUrl("notes/" +
                                            createSlug(note.data.title, note.slug))
                                        }
                                        target="_self"
                                        badge={note.data.badge}
                                        tags={note.data.tags}
                                    />
                                    <div class="divider my-0" />
                                </>
                            ))}
                        </ul>
                    </section>
                ) : null
            )
        )
    }

    <div class="flex justify-between">
        {
            page.url.prev ? (
                <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
                    {" "}
                    <svg
                        class="h-6 w-6 fill-current md:h-8 md:w-8"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                    >
                        <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                    </svg>{" "}
                    Recent notes
                </a>
            ) : (
                <div />
            )
        }
        {
            page.url.next ? (
                <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
                    Older notes{" "}
                    <svg
                        class="h-6 w-6 fill-current md:h-8 md:w-8"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                    >
                        {" "}
                        <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                    </svg>
                </a>
            ) : (
                <div />
            )
        }
    </div>
</BaseLayout>
