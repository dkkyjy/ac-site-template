---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";
import { AUTHOR_INITIAL, url as baseUrl } from "../../config";

export async function getStaticPaths({ paginate }) {
    const notes = await getCollection("notes");
    notes.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return paginate(notes, { pageSize: 100 });
}

const { page } = Astro.props;

// 按「学习项目」分组展示
const CATEGORY_ORDER = [
    "多智能体编排",
    "AI 开发方法论",
    "OMC / OMX 工作流",
    "代码审查",
    "Matt Pocock",
    "技能库 / 框架",
    "专项工具 / 科研",
];
const groups = CATEGORY_ORDER.map((cat) => ({
    name: cat,
    items: page.data.filter((n) => n.data.category === cat),
}));
const hasAny = groups.some((g) => g.items.length > 0);
// 非空分组（用于生成筛选按钮）
const nonEmpty = groups.filter((g) => g.items.length > 0);
---

<BaseLayout title={AUTHOR_INITIAL + " | Notes"} sideBarActiveItemID="notes">
    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Notes</div>
    </div>

    <div class="mb-6 flex flex-wrap gap-2" id="notes-cat-filters">
        <button type="button" data-cat="all" class="btn btn-sm btn-primary">
            全部
        </button>
        {
            nonEmpty.map((g, i) => (
                <button type="button" data-cat={g.name} class="btn btn-sm btn-outline">
                    {g.name}
                </button>
            ))
        }
    </div>

    {
        !hasAny ? (
            <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
                <p class="font-bold">Sorry!</p>
                <p>
                    There are no notes to show at the moment. Check back later!
                </p>
            </div>
        ) : (
            groups.map((group, gi) =>
                group.items.length > 0 ? (
                    <section class="mb-8 note-group" data-cat={group.name}>
                        <h2 class="text-xl font-bold mb-3 text-primary">
                            {group.name}
                        </h2>
                        <ul>
                            {group.items.map((note) => (
                                <>
                                    <HorizontalCard
                                        title={note.data.title}
                                        img={note.data.heroImage}
                                        desc={note.data.description}
                                        url={
                                            baseUrl("notes/" +
                                            createSlug(note.data.title, note.slug))
                                        }
                                        target="_self"
                                        badge={note.data.badge}
                                        tags={note.data.tags}
                                    />
                                    <div class="divider my-0" />
                                </>
                            ))}
                        </ul>
                    </section>
                ) : null
            )
        )
    }

    <div class="flex justify-between">
        {
            page.url.prev ? (
                <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
                    {" "}
                    <svg
                        class="h-6 w-6 fill-current md:h-8 md:w-8"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                    >
                        <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                    </svg>{" "}
                    Recent notes
                </a>
            ) : (
                <div />
            )
        }
        {
            page.url.next ? (
                <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
                    Older notes{" "}
                    <svg
                        class="h-6 w-6 fill-current md:h-8 md:w-8"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                    >
                        {" "}
                        <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                    </svg>
                </a>
            ) : (
                <div />
            )
        }
    </div>

    <script is:inline>
        (function () {
            var btnWrap = document.getElementById("notes-cat-filters");
            if (!btnWrap) return;
            var groups = document.querySelectorAll(".note-group");
            var btns = btnWrap.querySelectorAll("button");
            function apply(sel) {
                groups.forEach(function (g) {
                    g.style.display = sel === "all" || g.getAttribute("data-cat") === sel
                        ? "" : "none";
                });
                btns.forEach(function (b) {
                    var active = b.getAttribute("data-cat") === sel;
                    b.classList.toggle("btn-primary", active);
                    b.classList.toggle("btn-outline", !active);
                });
                if (sel === "all") {
                    var allBtn = btnWrap.querySelector('[data-cat="all"]');
                    allBtn.classList.add("btn-primary");
                    allBtn.classList.remove("btn-outline");
                }
            }
            btns.forEach(function (b) {
                b.addEventListener("click", function () {
                    apply(b.getAttribute("data-cat"));
                });
            });
            // 默认高亮“全部”
            apply("all");
        })();
    </script>
</BaseLayout>
